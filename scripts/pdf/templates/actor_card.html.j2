    <div class="actor-card{% if actor.artwork_uri %} has-artwork{% endif %}">
      {% if actor.artwork_uri %}<a class="actor-artwork" href="{{ actor.artwork_url }}"><img src="{{ actor.artwork_uri }}" alt="{{ actor.name }} {{ actor.artwork_kind }}"></a>{% endif %}
      <div class="actor-card-content">
      <div class="actor-card-header{% if actor.artwork_uri %} has-artwork{% endif %}">
        <div class="actor-identity">
        <div class="name">{{ actor.name }}{% if actor.continuation_total > 1 %}<span class="actor-continuation">continued {{ actor.continuation_index }} / {{ actor.continuation_total }}</span>{% endif %}</div>
        <div class="meta">
          {{ actor.role }}{% if actor.court_or_county %} · {{ actor.court_or_county }}{% endif %} · <span class="families">{{ actor.submission_count }} {% if actor.submission_count == 1 %}submission{% else %}submissions{% endif %}</span>
        </div>
        {% if actor.artwork_source == 'published' %}<p class="artwork-note">Current published actor slide. State and registry totals within the slide reflect its own snapshot.</p>{% endif %}
        </div>
      </div>
      {% if actor.comments %}
      <ul class="actor-comments">
        {% for c in actor.comments %}
        <li>
          {% if c.continued_from_previous %}<span class="comment-continuation">Family comment continued</span>{% endif %}
          <span class="comment-text">"{{ c.note }}"</span>
          {% if c.continues %}<span class="comment-continuation">Continues on the next card</span>{% endif %}
          {% if c.court_or_county and c.court_or_county != actor.court_or_county %}<span class="comment-county">{{ c.court_or_county }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if actor.complaint_packet_url %}
      <div class="actor-complaint">
        <strong>Create Complaint Packet:</strong>
        {% if actor.complaint_agency_name %}{{ actor.complaint_agency_name }} · {% endif %}
        <a href="{{ actor.complaint_packet_url }}">{{ actor.complaint_packet_url }}</a>
        <br>
        Family-reported pattern context only. Each person must file only their own truthful, first-hand complaint using their own facts, dates, evidence, orders, transcripts, and documents.
      </div>
      {% endif %}
      </div>
    </div>
